{
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=MunicipalServices.db;Cache=Shared"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Information"
        }
    },
    "AllowedHosts": "*",
    "DatabaseSettings": {
        "DatabasePath": "MunicipalServices.db",
        "SeedDemoData": true,
        "EnableDetailedLogging": true,
        "BackupOnStartup": true,
        "MaxDatabaseSizeMB": 100,
        "EnableWALMode": true
    }
}
