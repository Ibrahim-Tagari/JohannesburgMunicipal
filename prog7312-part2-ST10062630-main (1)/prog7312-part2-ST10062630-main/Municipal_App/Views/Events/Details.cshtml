@model Municipal_App.Models.LocalEvent
@{
    ViewData["Title"] = Model.Title;
    var relatedEvents = ViewBag.RelatedEvents as List<Municipal_App.Models.LocalEvent> ?? new List<Municipal_App.Models.LocalEvent>();
}

<div class="container py-4">
    Breadcrumb
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Events</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        Main Content
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    Event Header
                    <div class="mb-4">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-primary fs-6">@Model.Category</span>
                            @if (Model.Priority == 1)
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="fas fa-exclamation-circle me-1"></i>High Priority
                                </span>
                            }
                            <span class="badge bg-secondary fs-6">
                                <i class="fas fa-eye me-1"></i>@Model.ViewCount views
                            </span>
                        </div>
                        <h1 class="display-5 fw-bold mb-3">@Model.Title</h1>
                        <p class="lead text-muted">@Model.Description</p>
                    </div>

                    <hr class="my-4">

                    Event Details Grid
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-icon bg-primary bg-opacity-10 text-primary">
                                    <i class="fas fa-calendar-alt fa-lg"></i>
                                </div>
                                <div class="detail-content">
                                    <h6 class="fw-bold mb-1">Date</h6>
                                    <p class="mb-0">@Model.EventDate.ToString("MMMM dd, yyyy")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-icon bg-success bg-opacity-10 text-success">
                                    <i class="fas fa-clock fa-lg"></i>
                                </div>
                                <div class="detail-content">
                                    <h6 class="fw-bold mb-1">Time</h6>
                                    <p class="mb-0">@Model.EventDate.ToString("hh:mm tt")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-icon bg-danger bg-opacity-10 text-danger">
                                    <i class="fas fa-map-marker-alt fa-lg"></i>
                                </div>
                                <div class="detail-content">
                                    <h6 class="fw-bold mb-1">Location</h6>
                                    <p class="mb-0">@Model.Location</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-icon bg-info bg-opacity-10 text-info">
                                    <i class="fas fa-user fa-lg"></i>
                                </div>
                                <div class="detail-content">
                                    <h6 class="fw-bold mb-1">Organizer</h6>
                                    <p class="mb-0">@Model.Organizer</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    Action Buttons
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary btn-lg" onclick="alert('Calendar feature coming soon!')">
                            <i class="fas fa-calendar-plus me-2"></i>Add to Calendar
                        </button>
                        <button class="btn btn-outline-primary btn-lg" onclick="shareEvent()">
                            <i class="fas fa-share-alt me-2"></i>Share Event
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-arrow-left me-2"></i>Back to Events
                        </a>
                    </div>
                </div>
            </div>
        </div>

        Sidebar
        <div class="col-lg-4">
            Event Info Card
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-info-circle me-2"></i>
                        Event Information
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3">
                            <strong>Category:</strong><br>
                            <span class="badge bg-primary mt-1">@Model.Category</span>
                        </li>
                        <li class="mb-3">
                            <strong>Priority Level:</strong><br>
                            @if (Model.Priority == 1)
                            {
                                <span class="badge bg-danger mt-1">High Priority</span>
                            }
                            else if (Model.Priority == 2)
                            {
                                <span class="badge bg-warning text-dark mt-1">Medium Priority</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mt-1">Low Priority</span>
                            }
                        </li>
                        <li class="mb-3">
                            <strong>Created:</strong><br>
                            @Model.CreatedDate.ToString("MMM dd, yyyy")
                        </li>
                        <li class="mb-0">
                            <strong>Days Until Event:</strong><br>
                            @{
                                var daysUntil = (Model.EventDate - DateTime.Now).Days;
                                var daysClass = daysUntil <= 3 ? "danger" : daysUntil <= 7 ? "warning" : "success";
                            }
                            <span class="badge bg-@daysClass mt-1">@daysUntil days</span>
                        </li>
                    </ul>
                </div>
            </div>

            Related Events
            @if (relatedEvents.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-calendar-week me-2"></i>
                            Related Events
                        </h5>
                    </div>
                    <div class="card-body">
                        @foreach (var related in relatedEvents)
                        {
                            <div class="related-event-item mb-3 pb-3 border-bottom">
                                <h6 class="fw-bold mb-2">
                                    <a asp-action="Details" asp-route-id="@related.EventId" class="text-decoration-none">
                                        @related.Title
                                    </a>
                                </h6>
                                <p class="small text-muted mb-2">
                                    <i class="fas fa-calendar me-1"></i>
                                    @related.EventDate.ToString("MMM dd, yyyy")
                                </p>
                                <a asp-action="Details" asp-route-id="@related.EventId" class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function shareEvent() {
            if (navigator.share) {
                navigator.share({
                    title: '@Model.Title',
                    text: '@Model.Description',
                    url: window.location.href
                }).catch(err => console.log('Error sharing:', err));
            } else {
                // Fallback - copy to clipboard
                navigator.clipboard.writeText(window.location.href);
                alert('Event link copied to clipboard!');
            }
        }
    </script>
}

<style>
    .detail-item {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .detail-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .detail-content h6 {
        color: #6c757d;
        font-size: 0.875rem;
    }

    .detail-content p {
        color: #212529;
        font-size: 1rem;
    }

    .related-event-item:last-child {
        border-bottom: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }
</style>
