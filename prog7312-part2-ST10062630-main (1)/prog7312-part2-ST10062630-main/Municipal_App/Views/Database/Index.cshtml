@{
    ViewData["Title"] = "Database Management";
    var databaseInfo = ViewBag.DatabaseInfo as Municipal_App.Models.DatabaseInfo;
    var availableBackups = ViewBag.AvailableBackups as List<dynamic>;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-database"></i> Database Management</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Database Management</li>
                    </ol>
                </nav>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Database Information Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0"><i class="fas fa-info-circle"></i> Database Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Database Path:</strong></td>
                                    <td><code>@databaseInfo?.DatabasePath</code></td>
                                </tr>
                                <tr>
                                    <td><strong>Database Size:</strong></td>
                                    <td>@(databaseInfo?.SizeMB.ToString("F2")) MB</td>
                                </tr>
                                <tr>
                                    <td><strong>Last Modified:</strong></td>
                                    <td>
                                        @(databaseInfo?.LastModified?.ToString("yyyy-MM-dd HH:mm:ss"))
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Total Users:</strong></td>
                                    <td><span class="badge bg-info">@databaseInfo?.UserCount</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Total Issues:</strong></td>
                                    <td><span class="badge bg-warning">@databaseInfo?.IssueCount</span></td>
                                </tr>
                                <tr>
                                    <td><strong>WAL Mode:</strong></td>
                                    <td>
                                        @if (databaseInfo?.WALModeEnabled == true)
                                        {
                                            <span class="badge bg-success">Enabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>SQLite Version:</strong></td>
                                    <td>@databaseInfo?.Version</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Database Operations Card -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0"><i class="fas fa-tools"></i> Database Operations</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <form asp-action="CreateBackup" method="post" class="d-inline">
                                <button type="submit" class="btn btn-primary w-100" onclick="return confirm('Create a new database backup?')">
                                    <i class="fas fa-save"></i> Create Backup
                                </button>
                            </form>
                        </div>
                        <div class="col-md-3 mb-3">
                            <form asp-action="OptimizeDatabase" method="post" class="d-inline">
                                <button type="submit" class="btn btn-info w-100" onclick="return confirm('Optimize the database? This may take a few moments.')">
                                    <i class="fas fa-rocket"></i> Optimize Database
                                </button>
                            </form>
                        </div>
                        <div class="col-md-3 mb-3">
                            <form asp-action="VacuumDatabase" method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning w-100" onclick="return confirm('Vacuum the database to reclaim space? This may take a few moments.')">
                                    <i class="fas fa-compress-arrows-alt"></i> Vacuum Database
                                </button>
                            </form>
                        </div>
                        <div class="col-md-3 mb-3">
                            <button type="button" class="btn btn-secondary w-100" onclick="location.reload()">
                                <i class="fas fa-sync-alt"></i> Refresh Info
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Available Backups Card -->
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0"><i class="fas fa-archive"></i> Available Backups</h5>
                </div>
                <div class="card-body">
                    @if (availableBackups != null && availableBackups.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Backup File</th>
                                        <th>Created Date</th>
                                        <th>Size (MB)</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var backup in availableBackups)
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-file-archive text-primary"></i>
                                                @backup.FileName
                                            </td>
                                            <td>@backup.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td>@backup.SizeMB.ToString("F2")</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("DownloadBackup", new { backupPath = backup.Path })"
                                                       class="btn btn-sm btn-outline-primary" title="Download Backup">
                                                        <i class="fas fa-download"></i> Download
                                                    </a>
                                                    <form asp-action="RestoreBackup" method="post" class="d-inline">
                                                        <input type="hidden" name="backupPath" value="@backup.Path" />
                                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                                onclick="return confirm('Restore from this backup? This will replace the current database. The current database will be backed up first.')"
                                                                title="Restore from Backup">
                                                            <i class="fas fa-undo"></i> Restore
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-archive fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No backups available. Create your first backup using the button above.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }

    .card-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    }

    .table-responsive {
        border-radius: 0.375rem;
    }

    .btn-group .btn {
        margin-right: 0;
    }

    .alert {
        border: none;
        border-radius: 0.5rem;
    }

    code {
        background-color: #f8f9fa;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        font-size: 0.875em;
    }
</style>
