@{
    ViewData["Title"] = "About Us";
}

<div class="about-hero bg-gradient-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="fas fa-building me-3"></i>
                    About Municipal Services South Africa
                </h1>
                <p class="lead mb-4">
                    Transforming municipal service delivery through innovative digital solutions,
                    connecting South African citizens with their local government like never before.
                </p>
                <div class="d-flex flex-wrap gap-4">
                    <div class="stat-highlight">
                        <div class="stat-number">50+</div>
                        <div class="stat-label">Municipalities</div>
                    </div>
                    <div class="stat-highlight">
                        <div class="stat-number">10,000+</div>
                        <div class="stat-label">Citizens Served</div>
                    </div>
                    <div class="stat-highlight">
                        <div class="stat-number">95%</div>
                        <div class="stat-label">Resolution Rate</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <img src="/placeholder.svg?height=300&width=400"
                     alt="About Us" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row mb-5">
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="icon-circle bg-primary text-white mb-3">
                            <i class="fas fa-eye fa-2x"></i>
                        </div>
                        <h3 class="text-primary">Our Mission</h3>
                    </div>
                    <p class="text-muted">
                        To bridge the gap between South African citizens and their municipal governments
                        by providing accessible, efficient, and transparent digital service delivery
                        platforms that empower communities and enhance local governance.
                    </p>
                    <p class="text-muted">
                        We believe that every citizen deserves responsive municipal services and
                        clear communication channels with their local government representatives.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="icon-circle bg-success text-white mb-3">
                            <i class="fas fa-lightbulb fa-2x"></i>
                        </div>
                        <h3 class="text-success">Our Vision</h3>
                    </div>
                    <p class="text-muted">
                        To become South Africa's leading municipal services platform, fostering
                        stronger communities through digital innovation, transparency, and
                        collaborative governance that serves all citizens equitably.
                    </p>
                    <p class="text-muted">
                        We envision a future where municipal service delivery is seamless,
                        transparent, and responsive to the diverse needs of all South Africans.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <div class="text-center mb-5">
                <h2 class="display-6 fw-bold text-primary mb-3">Our Core Values</h2>
                <p class="lead text-muted">The principles that guide everything we do</p>
            </div>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="text-center">
                        <div class="value-icon bg-warning text-white mb-3">
                            <i class="fas fa-hands-helping fa-2x"></i>
                        </div>
                        <h5 class="text-warning fw-bold">Ubuntu</h5>
                        <p class="text-muted small">
                            "I am because we are" - fostering community spirit and
                            collective responsibility in municipal service delivery.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="text-center">
                        <div class="value-icon bg-info text-white mb-3">
                            <i class="fas fa-shield-alt fa-2x"></i>
                        </div>
                        <h5 class="text-info fw-bold">Integrity</h5>
                        <p class="text-muted small">
                            Maintaining the highest standards of honesty, transparency,
                            and ethical conduct in all our interactions.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="text-center">
                        <div class="value-icon bg-primary text-white mb-3">
                            <i class="fas fa-rocket fa-2x"></i>
                        </div>
                        <h5 class="text-primary fw-bold">Innovation</h5>
                        <p class="text-muted small">
                            Continuously evolving our platform with cutting-edge
                            technology to better serve South African communities.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="text-center">
                        <div class="value-icon bg-success text-white mb-3">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                        <h5 class="text-success fw-bold">Inclusivity</h5>
                        <p class="text-muted small">
                            Ensuring our services are accessible to all South Africans,
                            regardless of language, location, or technical ability.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-8">
            <h2 class="fw-bold text-primary mb-4">Our Story</h2>
            <p class="text-muted mb-4">
                Municipal Services South Africa was founded in 2022 with a simple but powerful vision:
                to transform how South African citizens interact with their local government.
                Born from the recognition that traditional municipal service channels were often
                inefficient and inaccessible, our platform emerged as a digital bridge between
                communities and their representatives.
            </p>
            <p class="text-muted mb-4">
                Starting with a pilot program in Johannesburg, we quickly expanded across
                Gauteng, Western Cape, and KwaZulu-Natal. Today, we serve over 50 municipalities
                nationwide, processing thousands of service requests monthly and maintaining
                a 95% citizen satisfaction rate.
            </p>
            <p class="text-muted mb-4">
                Our success stems from understanding the unique challenges faced by South African
                municipalities - from infrastructure constraints to diverse linguistic needs.
                We've built our platform to be robust, multilingual, and accessible even in
                areas with limited internet connectivity.
            </p>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker bg-primary"></div>
                    <div class="timeline-content">
                        <h6 class="fw-bold">2022 - Platform Launch</h6>
                        <p class="small text-muted mb-0">Initial deployment in Johannesburg metropolitan area</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker bg-success"></div>
                    <div class="timeline-content">
                        <h6 class="fw-bold">2023 - Provincial Expansion</h6>
                        <p class="small text-muted mb-0">Extended services to Western Cape and KwaZulu-Natal</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker bg-warning"></div>
                    <div class="timeline-content">
                        <h6 class="fw-bold">2024 - National Reach</h6>
                        <p class="small text-muted mb-0">Serving 50+ municipalities across all provinces</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="text-primary mb-4">Key Achievements</h5>
                    <div class="achievement-list">
                        <div class="achievement-item mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>10,000+ Citizens Registered</span>
                        </div>
                        <div class="achievement-item mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>25,000+ Issues Resolved</span>
                        </div>
                        <div class="achievement-item mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>95% Citizen Satisfaction</span>
                        </div>
                        <div class="achievement-item mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>24/7 Platform Availability</span>
                        </div>
                        <div class="achievement-item mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>11 Official Languages Supported</span>
                        </div>
                        <div class="achievement-item mb-0">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>Award for Digital Innovation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <div class="text-center mb-5">
                <h2 class="display-6 fw-bold text-primary mb-3">Meet Our Leadership Team</h2>
                <p class="lead text-muted">Dedicated professionals committed to serving South African communities</p>
            </div>
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="team-card card border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <img src="/Images/Thabo Molefe.png?height=150&width=150"
                                 alt="CEO" class="team-photo rounded-circle mb-3">
                            <h5 class="fw-bold text-primary">Thabo Mthembu</h5>
                            <p class="text-muted mb-3">Chief Executive Officer</p>
                            <p class="small text-muted">
                                With 15+ years in municipal governance and digital transformation,
                                Thabo leads our mission to revolutionize citizen services across South Africa.
                            </p>
                            <div class="social-links">
                                <a href="#" class="text-primary me-2"><i class="fab fa-linkedin"></i></a>
                                <a href="#" class="text-info"><i class="fab fa-twitter"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="team-card card border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <img src="/placeholder.svg?height=150&width=150"
                                 alt="CTO" class="team-photo rounded-circle mb-3">
                            <h5 class="fw-bold text-primary">Sarah van der Merwe</h5>
                            <p class="text-muted mb-3">Chief Technology Officer</p>
                            <p class="small text-muted">
                                A technology visionary with expertise in scalable platforms and
                                cybersecurity, Sarah ensures our systems serve millions reliably.
                            </p>
                            <div class="social-links">
                                <a href="#" class="text-primary me-2"><i class="fab fa-linkedin"></i></a>
                                <a href="#" class="text-success"><i class="fab fa-github"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="team-card card border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <img src="/placeholder.svg?height=150&width=150"
                                 alt="COO" class="team-photo rounded-circle mb-3">
                            <h5 class="fw-bold text-primary">Mandla Ndlovu</h5>
                            <p class="text-muted mb-3">Chief Operations Officer</p>
                            <p class="small text-muted">
                                Mandla oversees daily operations and municipal partnerships,
                                ensuring seamless service delivery across all our supported regions.
                            </p>
                            <div class="social-links">
                                <a href="#" class="text-primary me-2"><i class="fab fa-linkedin"></i></a>
                                <a href="#" class="text-info"><i class="fab fa-twitter"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="cta-section bg-gradient-primary text-white rounded p-5 text-center">
                <h2 class="fw-bold mb-3">Ready to Get Started?</h2>
                <p class="lead mb-4">
                    Join thousands of South Africans who are already experiencing
                    better municipal services through our platform.
                </p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-controller="Issues" asp-action="Report" class="btn btn-light btn-lg">
                            <i class="fas fa-plus-circle me-2"></i>Report an Issue
                        </a>
                        <a asp-controller="Issues" asp-action="TrackIssue" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-search me-2"></i>Track My Issues
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-controller="Account" asp-action="Signup" class="btn btn-light btn-lg">
                            <i class="fas fa-user-plus me-2"></i>Create Account
                        </a>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-envelope me-2"></i>Contact Us
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .about-hero {
        background: linear-gradient(135deg, #0066cc 0%, #004499 100%);
    }

    .stat-highlight {
        text-align: center;
    }

        .stat-highlight .stat-number {
            font-size: 2rem;
            font-weight: bold;
            display: block;
        }

        .stat-highlight .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

    .icon-circle, .value-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .timeline {
        position: relative;
        padding-left: 30px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 30px;
    }

    .timeline-marker {
        position: absolute;
        left: -23px;
        top: 0;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: 0 0 0 2px #dee2e6;
    }

    .timeline-content {
        margin-left: 20px;
    }

    .team-photo {
        width: 120px;
        height: 120px;
        object-fit: cover;
    }

    .achievement-item {
        display: flex;
        align-items: center;
    }

    .social-links a {
        font-size: 1.2rem;
    }

    .team-card:hover {
        transform: translateY(-5px);
        transition: all 0.3s ease;
    }
</style>
