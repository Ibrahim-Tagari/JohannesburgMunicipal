@model Municipal_App.Models.SignupViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-10 col-md-10 col-lg-9 col-xl-8">
            <div class="card shadow-lg border-0 auth-card" style="width: 450px;">
                <div class="card-header bg-gradient-success text-white text-center py-4">
                    <h2 class="mb-0 fw-bold">
                        <i class="fas fa-user-plus me-3"></i>
                        Create Account
                    </h2>
                    <p class="mb-0 mt-2 opacity-75">Join our municipal services platform</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Signup" method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <!-- Personal Information Section -->
                        <div class="mb-4">
                            <h5 class="text-muted mb-3 border-bottom pb-2">
                                <i class="fas fa-user me-2"></i>
                                Personal Information
                            </h5>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="Username" class="form-label fs-6 fw-semibold mb-2">
                                        <i class="fas fa-user me-2 text-primary"></i>
                                        @Html.DisplayNameFor(m => m.Username) *
                                    </label>
                                    <input asp-for="Username" class="form-control form-control-lg py-3"
                                           placeholder="Choose a unique username" autocomplete="username" />
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fs-6 fw-semibold mb-2">
                                        <i class="fas fa-envelope me-2 text-primary"></i>
                                        @Html.DisplayNameFor(m => m.Email) *
                                    </label>
                                    <input asp-for="Email" class="form-control form-control-lg py-3"
                                           placeholder="your.email@example.com" autocomplete="email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fs-6 fw-semibold mb-2">
                                        <i class="fas fa-id-card me-2 text-primary"></i>
                                        @Html.DisplayNameFor(m => m.FullName)
                                    </label>
                                    <input asp-for="FullName" class="form-control form-control-lg py-3"
                                           placeholder="Your full name" autocomplete="name" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label fs-6 fw-semibold mb-2">
                                        <i class="fas fa-phone me-2 text-primary"></i>
                                        @Html.DisplayNameFor(m => m.PhoneNumber)
                                    </label>
                                    <input asp-for="PhoneNumber" class="form-control form-control-lg py-3"
                                           placeholder="+27 11 123 4567" autocomplete="tel" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Security Section -->
                        <div class="mb-4">
                            <h5 class="text-muted mb-3 border-bottom pb-2">
                                <i class="fas fa-shield-alt me-2"></i>
                                Security & Access
                            </h5>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label fs-6 fw-semibold mb-2">
                                        <i class="fas fa-lock me-2 text-primary"></i>
                                        @Html.DisplayNameFor(m => m.Password) *
                                    </label>
                                    <input asp-for="Password" class="form-control form-control-lg py-3"
                                           placeholder="At least 6 characters" autocomplete="new-password" />
                                    <div class="form-text">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Use a strong password with letters, numbers, and symbols
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label fs-6 fw-semibold mb-2">
                                        <i class="fas fa-lock me-2 text-primary"></i>
                                        @Html.DisplayNameFor(m => m.ConfirmPassword) *
                                    </label>
                                    <input asp-for="ConfirmPassword" class="form-control form-control-lg py-3"
                                           placeholder="Confirm your password" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label for="Role" class="form-label fs-6 fw-semibold mb-2">
                                        <i class="fas fa-user-shield me-2 text-primary"></i>
                                        Account Type
                                    </label>
                                    <select name="Role" class="form-select form-select-lg py-3">
                                        <option value="User">Regular User</option>
                                        <option value="Admin">Administrator</option>
                                    </select>
                                    <div class="form-text">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Select "Administrator" only if you need admin access to manage all issues
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-success btn-lg py-3 fw-semibold">
                                <i class="fas fa-user-plus me-2"></i>
                                Create My Account
                            </button>
                        </div>
                    </form>

                    <div class="text-center">
                        <div class="d-flex align-items-center mb-3">
                            <hr class="flex-grow-1">
                            <span class="px-3 text-muted small">ALREADY REGISTERED?</span>
                            <hr class="flex-grow-1">
                        </div>
                        <p class="mb-2 text-muted">Already have an account?</p>
                        <a asp-action="Login" class="btn btn-outline-primary btn-lg px-4">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Sign In Here
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
