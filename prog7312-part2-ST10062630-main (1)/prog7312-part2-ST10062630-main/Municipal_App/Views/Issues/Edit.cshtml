@model Municipal_App.Models.ReportIssueViewModel
@{
    ViewData["Title"] = $"Edit Issue #{Model.Id}";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Back Button -->
            <div class="mb-3">
                <a asp-action="IssueLog" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>
                    Back to Issue Log
                </a>
            </div>

            <!-- Edit Issue Form -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Edit Issue #@Model.Id
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Location" class="form-label fw-semibold">
                                    <i class="fas fa-map-marker-alt me-1"></i>
                                    Location *
                                </label>
                                <input asp-for="Location" class="form-control form-control-lg"
                                       placeholder="e.g., 123 Main Street, Downtown" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label fw-semibold">
                                    <i class="fas fa-tag me-1"></i>
                                    Category *
                                </label>
                                <select asp-for="Category" class="form-select form-select-lg">
                                    <option value="">Select a category</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="fas fa-align-left me-1"></i>
                                Description *
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="5"
                                      placeholder="Provide a detailed description of the issue..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Priority" class="form-label fw-semibold">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    Priority *
                                </label>
                                <select asp-for="Priority" class="form-select form-select-lg">
                                    @foreach (var priority in Model.Priorities)
                                    {
                                        <option value="@priority">@priority</option>
                                    }
                                </select>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ContactEmail" class="form-label fw-semibold">
                                    <i class="fas fa-envelope me-1"></i>
                                    Contact Email
                                </label>
                                <input asp-for="ContactEmail" class="form-control form-control-lg" type="email"
                                       placeholder="your.email@example.com" />
                                <span asp-validation-for="ContactEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactPhone" class="form-label fw-semibold">
                                <i class="fas fa-phone me-1"></i>
                                Contact Phone
                            </label>
                            <input asp-for="ContactPhone" class="form-control form-control-lg" type="tel"
                                   placeholder="+27 XX XXX XXXX" />
                            <span asp-validation-for="ContactPhone" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AttachedFiles" class="form-label fw-semibold">
                                <i class="fas fa-paperclip me-1"></i>
                                Add Additional Files (Optional)
                            </label>
                            <input asp-for="AttachedFiles" class="form-control" type="file" multiple
                                   accept="image/*,.pdf,.doc,.docx" />
                            <small class="form-text text-muted">
                                You can attach images or documents (PDF, DOC, DOCX). Maximum 5 files.
                            </small>
                            <span asp-validation-for="AttachedFiles" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="IssueLog" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-times me-1"></i>
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-1"></i>
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
