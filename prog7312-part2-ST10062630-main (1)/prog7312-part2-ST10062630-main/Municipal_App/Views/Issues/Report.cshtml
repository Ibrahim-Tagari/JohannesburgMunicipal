@model Municipal_App.Models.ReportIssueViewModel
@{
    ViewData["Title"] = "Report Issue";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Report Municipal Issue
                </h3>
            </div>
            <div class="card-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="mb-3">
                    <div class="progress">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 25%" id="progressBar">
                            Step 1 of 4: Provide Issue Details
                        </div>
                    </div>
                </div>

                <form asp-action="Report" method="post" enctype="multipart/form-data" id="issueForm">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Location" class="form-label">
                                    <i class="fas fa-map-marker-alt me-1"></i>
                                    @Html.DisplayNameFor(m => m.Location) *
                                </label>
                                <input asp-for="Location" class="form-control" placeholder="e.g., Corner of Main St and Church St, Johannesburg" required />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Category" class="form-label">
                                    <i class="fas fa-tags me-1"></i>
                                    @Html.DisplayNameFor(m => m.Category) *
                                </label>
                                <select asp-for="Category" class="form-select" required>
                                    <option value="">Select a category...</option>
                                    <option value="Sanitation">Sanitation</option>
                                    <option value="Roads">Roads & Infrastructure</option>
                                    <option value="Utilities">Utilities</option>
                                    <option value="StreetLighting">Street Lighting</option>
                                    <option value="WaterSupply">Water Supply</option>
                                    <option value="WasteManagement">Waste Management</option>
                                    <option value="PublicSafety">Public Safety</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">
                            <i class="fas fa-edit me-1"></i>
                            @Html.DisplayNameFor(m => m.Description) *
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="5"
                                  placeholder="Please provide a detailed description of the issue, including when you first noticed it and any relevant details..."
                                  required minlength="10" maxlength="1000"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <div class="form-text">
                            <span id="charCount">0</span>/1000 characters (minimum 10 characters required)
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Priority" class="form-label">
                                    <i class="fas fa-exclamation-circle me-1"></i>
                                    Priority Level
                                </label>
                                <select asp-for="Priority" class="form-select">
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ContactEmail" class="form-label">
                                    <i class="fas fa-envelope me-1"></i>
                                    Contact Email (Optional)
                                </label>
                                <input asp-for="ContactEmail" type="email" class="form-control" placeholder="your.email@example.com" />
                                <span asp-validation-for="ContactEmail" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContactPhone" class="form-label">
                            <i class="fas fa-phone me-1"></i>
                            Contact Phone (Optional)
                        </label>
                        <input asp-for="ContactPhone" type="tel" class="form-control" placeholder="+27 11 123 4567" />
                        <span asp-validation-for="ContactPhone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AttachedFiles" class="form-label">
                            <i class="fas fa-paperclip me-1"></i>
                            @Html.DisplayNameFor(m => m.AttachedFiles)
                        </label>
                        <input asp-for="AttachedFiles" type="file" class="form-control" multiple
                               accept="image/*,.pdf,.doc,.docx" />
                        <div class="form-text">
                            You can attach images or documents (PDF, DOC, DOCX). Maximum 5 files, 10MB each.
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Engagement Tip:</strong>
                            <span id="engagementMessage">Providing detailed information helps us resolve your issue faster!</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-md-2">
                            <i class="fas fa-arrow-left me-1"></i>
                            Back to Main Menu
                        </a>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="AcceptTerms" />
                            <label class="form-check-label" asp-for="AcceptTerms">
                                I accept the terms and conditions
                            </label>
                            <span asp-validation-for="AcceptTerms" class="text-danger"></span>
                        </div>


                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="fas fa-paper-plane me-1"></i>
                            Submit Issue Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Character counter
            $('#Description').on('input', function() {
                var length = $(this).val().length;
                $('#charCount').text(length);

                // Update submit button state
                var submitBtn = $('#submitBtn');
                if (length < 10) {
                    submitBtn.prop('disabled', true);
                } else {
                    submitBtn.prop('disabled', false);
                }

                // Update progress bar based on form completion
                updateProgress();
            });

            // Update progress and engagement messages
            function updateProgress() {
                var progress = 25;
                var message = "Step 1 of 4: Provide Issue Details";
                var engagementMsg = "Providing detailed information helps us resolve your issue faster!";

                if ($('#Location').val().trim()) progress += 25;
                if ($('#Category').val()) progress += 25;
                if ($('#Description').val().length >= 10) progress += 25;

                if (progress >= 50) {
                    message = "Step 2 of 4: Great progress!";
                    engagementMsg = "You're doing great! Adding photos can help our team understand the issue better.";
                }
                if (progress >= 75) {
                    message = "Step 3 of 4: Almost done!";
                    engagementMsg = "Excellent! Your detailed report will help us prioritize and resolve this issue quickly.";
                }
                if (progress >= 100) {
                    message = "Step 4 of 4: Ready to submit!";
                    engagementMsg = "Perfect! Your comprehensive report is ready for submission.";
                }

                $('#progressBar').css('width', progress + '%').text(message);
                $('#engagementMessage').text(engagementMsg);
            }

            // Update progress on field changes
            $('#Location, #Category, #Priority').on('change input', updateProgress);

            // File upload validation
            $('input[type="file"]').on('change', function() {
                var files = this.files;
                if (files.length > 5) {
                    alert('You can only upload a maximum of 5 files.');
                    this.value = '';
                    return;
                }

                // Check file sizes (10MB limit per file)
                for (var i = 0; i < files.length; i++) {
                    if (files[i].size > 10 * 1024 * 1024) {
                        alert('File "' + files[i].name + '" is too large. Maximum file size is 10MB.');
                        this.value = '';
                        return;
                    }
                }

                updateProgress();
            });

            // Form submission handling
            $('#issueForm').on('submit', function(e) {
                var submitBtn = $('#submitBtn');
                var location = $('#Location').val().trim();
                var category = $('#Category').val();
                var description = $('#Description').val().trim();

                // Validate required fields
                if (!location || !category || !description || description.length < 10) {
                    e.preventDefault();
                    alert('Please fill in all required fields. Description must be at least 10 characters.');
                    return false;
                }

                // Disable submit button to prevent double submission
                submitBtn.prop('disabled', true);
                submitBtn.html('<i class="fas fa-spinner fa-spin me-1"></i>Submitting...');

                // Re-enable button after 10 seconds as fallback
                setTimeout(function() {
                    submitBtn.prop('disabled', false);
                    submitBtn.html('<i class="fas fa-paper-plane me-1"></i>Submit Issue Report');
                }, 10000);
            });

            // Initial progress update
            updateProgress();
        });
    </script>
}
