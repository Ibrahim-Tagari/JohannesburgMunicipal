@model List<Municipal_App.Models.Issue>

<div class="row" id="issueCards">
    @foreach (var issue in Model)
    {
        <div class="col-lg-6 col-xl-4 mb-4 issue-card" data-status="@issue.Status" data-category="@issue.Category">
            <div class="card h-100 shadow-sm border-0 hover-card">
                <!-- Card Header with Status and Date -->
                <div class="card-header bg-light border-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <small class="text-muted me-2">
                            <i class="fas fa-calendar me-1"></i>
                            @issue.DateReported.ToString("dd MMM yyyy")
                        </small>
                        @if (issue.LastUpdated.HasValue)
                        {
                            <small class="text-info">
                                <i class="fas fa-sync me-1"></i>
                                Updated @issue.LastUpdated.Value.ToString("dd MMM")
                            </small>
                        }
                    </div>
                    @{
                        var statusClass = issue.Status switch
                        {
                            "Submitted" => "bg-warning text-dark",
                            "Assigned" => "bg-info text-white",
                            "In Progress" => "bg-primary text-white",
                            "Resolved" => "bg-success text-white",
                            "Closed" => "bg-secondary text-white",
                            _ => "bg-secondary text-white"
                        };
                    }
                    <span class="badge @statusClass">
                        <i class="fas fa-circle me-1" style="font-size: 0.6em;"></i>
                        @issue.Status
                    </span>
                </div>

                <!-- Card Body -->
                <div class="card-body">
                    <!-- Issue ID and Priority -->
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="card-title mb-0 text-primary fw-bold">
                            <i class="fas fa-hashtag me-1"></i>
                            Issue @issue.Id
                        </h6>
                        @{
                            var priorityClass = issue.Priority switch
                            {
                                "Low" => "text-success",
                                "Medium" => "text-warning",
                                "High" => "text-danger",
                                "Critical" => "text-danger fw-bold",
                                _ => "text-secondary"
                            };
                        }
                        <small class="@priorityClass">
                            <i class="fas fa-flag me-1"></i>
                            @issue.Priority Priority
                        </small>
                    </div>

                    <!-- Location -->
                    <div class="mb-2">
                        <small class="text-muted d-flex align-items-center">
                            <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                            <span class="text-truncate">@issue.Location</span>
                        </small>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <span class="badge bg-light text-dark border">
                            <i class="fas fa-tag me-1"></i>
                            @issue.Category
                        </span>
                    </div>

                    <!-- Description Preview -->
                    <p class="card-text text-muted small mb-3">
                        @(issue.Description.Length > 120 ? issue.Description.Substring(0, 120) + "..." : issue.Description)
                    </p>

                    <!-- Additional Info -->
                    <div class="row g-2 mb-3">
                        @if (!string.IsNullOrEmpty(issue.AssignedTo))
                        {
                            <div class="col-12">
                                <small class="text-info d-flex align-items-center">
                                    <i class="fas fa-user me-2"></i>
                                    <span class="text-truncate">Assigned to: @issue.AssignedTo</span>
                                </small>
                            </div>
                        }

                        @if (issue.AttachedFiles.Any())
                        {
                            <div class="col-12">
                                <small class="text-success d-flex align-items-center">
                                    <i class="fas fa-paperclip me-2"></i>
                                    <span>@issue.AttachedFiles.Count file(s) attached</span>
                                </small>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(issue.ContactEmail))
                        {
                            <div class="col-12">
                                <small class="text-primary d-flex align-items-center">
                                    <i class="fas fa-envelope me-2"></i>
                                    <span class="text-truncate">@issue.ContactEmail</span>
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-transparent border-0">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <button class="btn btn-outline-primary btn-sm" onclick="viewIssueDetails(@issue.Id)">
                                <i class="fas fa-eye me-1"></i>
                                View Details
                            </button>

                            <div class="d-flex gap-1">
                                @if (issue.Status == "Resolved")
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="fas fa-check-circle me-1"></i>
                                        Complete
                                    </span>
                                }
                                else if (issue.Status == "In Progress")
                                {
                                    <span class="badge bg-primary-subtle text-primary">
                                        <i class="fas fa-spinner me-1"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning">
                                        <i class="fas fa-clock me-1"></i>
                                        Pending
                                    </span>
                                }
                            </div>
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="Issues" asp-action="UpdateStatus" asp-route-id="@issue.Id"
                                   class="btn btn-sm btn-warning flex-fill">
                                    <i class="fas fa-edit me-1"></i>
                                    Update Status
                                </a>
                                <a asp-controller="Issues" asp-action="Edit" asp-route-id="@issue.Id"
                                   class="btn btn-sm btn-info flex-fill">
                                    <i class="fas fa-pen me-1"></i>
                                    Edit Details
                                </a>
                                <form id="deleteForm@(issue.Id)" asp-controller="Issues" asp-action="Delete" asp-route-id="@issue.Id"
                                      method="post" class="d-inline flex-fill">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-danger w-100" onclick="confirmDelete(@issue.Id)">
                                        <i class="fas fa-trash me-1"></i>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="row">
        <div class="col-12">
            <div class="card text-center py-5">
                <div class="card-body">
                    <i class="fas fa-search fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No Issues Found</h4>
                    <p class="text-muted">No issues match your current search criteria.</p>
                    <button class="btn btn-outline-primary" onclick="clearFilters()">
                        <i class="fas fa-times me-1"></i>Clear Filters
                    </button>
                </div>
            </div>
        </div>
    </div>
}
