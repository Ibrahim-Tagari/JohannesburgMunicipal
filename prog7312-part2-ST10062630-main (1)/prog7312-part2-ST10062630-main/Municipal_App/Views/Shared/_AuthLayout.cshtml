<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Municipal Services</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="container-fluid">
        <div class="row min-vh-100">
            <!-- Left side - Branding -->
            <div class="col-md-6 d-none d-md-flex align-items-center justify-content-center bg-primary text-white">
                <div class="text-center">
                    <h1 class="display-4 mb-4">
                        🏛️ Municipal Services
                    </h1>
                    <p class="lead mb-4">Your gateway to efficient municipal service delivery in South Africa</p>
                    <div class="row text-center">
                        <div class="col-4">
                            <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                            <p class="small">Report Issues</p>
                        </div>
                        <div class="col-4">
                            <i class="fas fa-search fa-2x mb-2"></i>
                            <p class="small">Track Progress</p>
                        </div>
                        <div class="col-4">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <p class="small">Community</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right side - Auth Form -->
            <div class="col-md-6 d-flex align-items-center justify-content-center">
                <div class="w-100" style="max-width: 500px;">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
