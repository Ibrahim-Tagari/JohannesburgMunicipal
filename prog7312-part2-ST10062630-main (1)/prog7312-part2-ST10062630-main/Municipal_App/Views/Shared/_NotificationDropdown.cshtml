<div class="dropdown">
    <button class="btn btn-outline-light position-relative" type="button" id="notificationToggle"
            data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-bell"></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
              id="notificationBadge" style="display: none;">
            0
        </span>
    </button>

    <div class="dropdown-menu dropdown-menu-end notification-dropdown" id="notificationDropdown"
         style="width: 350px; max-height: 400px; overflow-y: auto;">

        <!-- Header -->
        <div class="dropdown-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
                <i class="fas fa-bell me-2"></i>
                Notifications
            </h6>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-primary btn-sm" id="markAllReadBtn" title="Mark all as read">
                    <i class="fas fa-check-double"></i>
                </button>
                <button class="btn btn-outline-secondary btn-sm" id="clearReadBtn" title="Clear read notifications">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>

        <div class="dropdown-divider"></div>

        <!-- Enable Notifications Button (shown when not enabled) -->
        <div class="dropdown-item text-center" id="enableNotificationsBtn" style="display: none;">
            <button class="btn btn-primary btn-sm">
                <i class="fas fa-bell me-2"></i>
                Enable Push Notifications
            </button>
        </div>

        <!-- Notifications List -->
        <div id="notificationList">
            <!-- Notifications will be loaded here via JavaScript -->
            <div class="dropdown-item text-center text-muted py-3">
                <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2">Loading notifications...</div>
            </div>
        </div>

        <div class="dropdown-divider"></div>

        <!-- Footer -->
        <div class="dropdown-item text-center">
            <small class="text-muted">
                <i class="fas fa-info-circle me-1"></i>
                Notifications update automatically
            </small>
        </div>
    </div>
</div>

<style>
    .notification-dropdown {
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .notification-item {
        border-bottom: 1px solid #f8f9fa;
        padding: 0.75rem 1rem;
        transition: background-color 0.2s;
    }

        .notification-item:hover {
            background-color: #f8f9fa;
        }

        .notification-item.unread {
            background-color: #e3f2fd;
            border-left: 3px solid #2196f3;
        }

        .notification-item.read {
            opacity: 0.7;
        }

    .notification-title {
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }

    .notification-message {
        font-size: 0.8rem;
        line-height: 1.3;
        margin-bottom: 0.25rem;
    }

    .notification-time {
        font-size: 0.75rem;
    }

    .notification-actions {
        display: flex;
        gap: 0.25rem;
    }

        .notification-actions .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }
</style>
