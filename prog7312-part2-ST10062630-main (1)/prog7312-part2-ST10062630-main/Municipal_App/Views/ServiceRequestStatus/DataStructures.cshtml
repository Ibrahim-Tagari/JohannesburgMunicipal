@model Dictionary<string, object>
@{
    ViewData["Title"] = "Data Structure Statistics";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-info">
                <i class="fas fa-chart-bar me-3"></i>Data Structure Statistics
            </h1>
            <p class="lead text-muted">Performance metrics and statistics for all implemented data structures</p>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-tree me-2"></i>Binary Search Tree</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Fast O(log n) search, insert, and delete operations</p>
                    <ul class="list-unstyled">
                        <li><strong>Nodes:</strong> @Model["BSTNodes"]</li>
                        <li><strong>Use Case:</strong> Fast ID lookups</li>
                        <li><strong>Time Complexity:</strong> O(log n) average</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-balance-scale me-2"></i>AVL Tree</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Self-balancing tree for guaranteed performance</p>
                    <ul class="list-unstyled">
                        <li><strong>Height:</strong> @Model["AVLHeight"]</li>
                        <li><strong>Use Case:</strong> Priority-based sorting</li>
                        <li><strong>Time Complexity:</strong> O(log n) guaranteed</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-circle me-2"></i>Red-Black Tree</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Balanced tree with simpler rotations than AVL</p>
                    <ul class="list-unstyled">
                        <li><strong>Nodes:</strong> @Model["RedBlackNodes"]</li>
                        <li><strong>Use Case:</strong> Frequent insertions/deletions</li>
                        <li><strong>Time Complexity:</strong> O(log n) guaranteed</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="fas fa-layer-group me-2"></i>Min-Heap</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Priority queue for urgent request management</p>
                    <ul class="list-unstyled">
                        <li><strong>Size:</strong> @Model["HeapSize"]</li>
                        <li><strong>Use Case:</strong> Extract highest priority</li>
                        <li><strong>Time Complexity:</strong> O(1) peek, O(log n) insert</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-project-diagram me-2"></i>Graph</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Dependency tracking and relationship mapping</p>
                    <ul class="list-unstyled">
                        <li><strong>Nodes:</strong> @Model["GraphNodes"]</li>
                        <li><strong>Edges:</strong> @Model["GraphEdges"]</li>
                        <li><strong>Has Cycles:</strong> @Model["HasCycles"]</li>
                        <li><strong>Traversal:</strong> BFS & DFS</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-bezier-curve me-2"></i>Minimum Spanning Tree</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Optimal clustering using Kruskal's algorithm</p>
                    <ul class="list-unstyled">
                        <li><strong>Optimal Cost:</strong> @string.Format("{0:F2}", Model["OptimalCost"])</li>
                        <li><strong>Use Case:</strong> Resource allocation</li>
                        <li><strong>Algorithm:</strong> Kruskal with Union-Find</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Overall Performance Summary</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="text-muted">Total Service Requests</h6>
                    <h3 class="fw-bold">@Model["TotalRequests"]</h3>
                </div>
                <div class="col-md-4">
                    <h6 class="text-muted">Data Structures Used</h6>
                    <h3 class="fw-bold">6</h3>
                    <p class="small text-muted">BST, AVL, RB-Tree, Heap, Graph, MST</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-muted">Average Time Complexity</h6>
                    <h3 class="fw-bold">O(log n)</h3>
                    <p class="small text-muted">For most operations</p>
                </div>
            </div>
        </div>
    </div>
</div>
